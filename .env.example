# ========================================================
# 뚝딱 대칭 공장 환경 변수 설정 안내 (.env.example)
# 실제 키 값은 이 파일이나 코드에 입력하지 마세요.
# Vercel 배포 시에는 'Project Settings > Environment Variables'에서 등록합니다.
# ========================================================

# [1. Firebase 웹 설정 - 브라우저 노출 가능]
# Firebase 콘솔 (https://console.firebase.google.com) > 프로젝트 설정 > 일반 > 내 앱(웹)에서 확인
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# [2. 공공데이터포털 전통문양 API - 서버 전용]
# 공공데이터포털(data.go.kr) > '한국문화정보원_전통문양' 활용신청 > 마이페이지의 '일반 인증키(Decoding)' 값
DATA_GO_KR_SERVICE_KEY=""

# [3. OpenAI API - 서버 전용]
# OpenAI 플랫폼 (https://platform.openai.com/api-keys)에서 발급받은 API Secret Key
OPENAI_API_KEY=""
# 사용할 모델 이름 (예: gpt-4o-mini 또는 gpt-4o)
OPENAI_MODEL="gpt-4o-mini"
